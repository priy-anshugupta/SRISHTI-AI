# Production Cloud Backend URL (e.g. your Render / Railway URL)
NEXT_PUBLIC_API_URL=https://srishti-ai-backend.onrender.com

# Server-side destination for Next.js /api rewrites (for Vercel serverless proxy)
BACKEND_URL=https://srishti-ai-backend.onrender.com

# Optional direct WebSocket URL (if omitted, Srishti automatically uses HTTP polling)
NEXT_PUBLIC_WS_URL=wss://srishti-ai-backend.onrender.com/ws/ertmac
