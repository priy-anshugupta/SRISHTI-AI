# Never commit real values. Copy to .env for local development.
APP_ENV=development
API_CORS_ORIGINS=http://localhost:3000
REQUIRE_AUTH=false

# Supabase: use the service-role key only in this FastAPI backend, never in Next.js.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=srishti-documents

# ─── HYBRID AI BRAIN CONFIGURATION (OPTIONAL) ───
# If NO key is provided, SRISHTI·AI runs 100% offline with zero errors using its deterministic rule engine.
# Set AI_PROVIDER to 'auto', 'groq', 'openai', 'gemini', 'ollama', or 'deterministic'.
AI_PROVIDER=auto

# Option A: Groq (Recommended Free Tier - Ultra-fast Llama-3.3-70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: OpenAI (GPT-4o-mini / GPT-4.1-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Option C: Google Gemini (Free Tier via OpenAI endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option D: Local Ollama (100% Offline Air-Gapped Rig Server)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

